/* 
1. Generating a Sequence of Numbers: Generate a sequence of numbers from 1 to 10.
2. Generate a Series of Dates: Generate a list of dates between two given dates (e.g., 2024-12-15 to 2025-01-10).
3. Calculating Factorial: Compute the factorial of a number 5 using a recursive CTE.

*/


with recursive numbers as (
select 1 as num
union all
select num + 1 from numbers
where num<10)

Select * from numbers;


with recursive dates as (
select cast('2024-12-15' as Date) as Dates
union all
select Date_add(Dates, interval 1 day) from dates
where dates < cast('2025-01-10'as date))

Select * from dates;



with recursive fact as (
select 1 as num, 1 as factorial
union all
select num+1, factorial * (num+1) from fact
where num<5)

Select * from fact;
